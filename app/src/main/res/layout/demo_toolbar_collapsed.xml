<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="45dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/demo_toolbar_tracker"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:contentDescription="@string/toolbar_tracker"
        android:src="@drawable/demo_toolbar_ic_tracker" />

    <ImageView
        android:id="@+id/demo_toolbar_info"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:contentDescription="@string/toolbar_info"
        android:src="@drawable/demo_toolbar_ic_info" />

    <ImageView
        android:id="@+id/demo_toolbar_settings"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:contentDescription="@string/toolbar_settings"
        android:src="@drawable/demo_toolbar_ic_settings" />
</LinearLayout>
